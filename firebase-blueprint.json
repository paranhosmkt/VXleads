{
  "entities": {
    "Company": {
      "title": "Company",
      "description": "Stores company registration details for billing and CRM",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "razaoSocial": { "type": "string" },
        "cnpj": { "type": "string" },
        "email": { "type": "string" },
        "telefone": { "type": "string" }
      }
    },
    "EventLead": {
      "title": "EventLead",
      "description": "Event participant lead, raffle results and voucher for industrial events (Mercopar 2026 and Grob Experience)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "crachaId": { "type": "string" },
        "nome": { "type": "string" },
        "empresa": { "type": "string" },
        "cargo": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "evento": { "type": "string" },
        "produto": { "type": "string" },
        "produtoId": { "type": "string" },
        "produtoNome": { "type": "string" },
        "premio": { "type": "string" },
        "premioDesconto": { "type": "string" },
        "premioBrinde": { "type": "string" },
        "voucher": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/companies/{uid}": {
      "schema": "Company",
      "description": "Company registration and settings"
    },
    "/event_leads/{leadId}": {
      "schema": "EventLead",
      "description": "Leads and raffles for Mercopar 2026 and Grob Experience"
    }
  }
}
